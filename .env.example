# ============================================
# 用法：把本文件复制为 .env，然后把下面的占位符
# 替换成你的真实 Key。.env 已加入 .gitignore，
# 不会被提交到 Git 仓库。
# ============================================

# 阿里百炼（Qwen）
# 获取方式：登录 https://bailian.console.aliyun.com → 右上角「API-KEY」→ 创建我的 API-KEY
DASHSCOPE_API_KEY=sk-your-api-key-here

# 以后拿到其他家的 Key，取消对应注释即可
# DEEPSEEK_API_KEY=
# ZHIPU_API_KEY=
# MOONSHOT_API_KEY=
